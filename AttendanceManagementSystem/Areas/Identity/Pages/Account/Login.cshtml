@page
@model LoginModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="auth-container">
    <div class="auth-card">
        <!-- Header -->
        <div class="auth-header">
            <div class="auth-logo">
                <i class="bi bi-journal-check"></i>
                <span>AttendanceEase</span>
            </div>
            <h1 class="auth-title">Welcome Back</h1>
            <p class="auth-subtitle">Sign in to access your attendance dashboard.</p>
        </div>

        <!-- Form -->
        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <!-- Email Field -->
            <div class="form-floating">
                <input asp-for="Input.Email" 
                       class="form-control" 
                       autocomplete="username" 
                       aria-required="true" 
                       placeholder="name@example.com"
                       autofocus />
                <label asp-for="Input.Email">
                    <i class="bi bi-envelope me-2"></i>Email Address
                </label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <!-- Password Field -->
            <div class="form-floating">
                <input asp-for="Input.Password" 
                       class="form-control" 
                       autocomplete="current-password" 
                       aria-required="true" 
                       placeholder="Password"
                       type="password" />
                <label asp-for="Input.Password">
                    <i class="bi bi-lock me-2"></i>Password
                </label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <!-- Remember Me and Forgot Password -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe">
                        Remember me
                    </label>
                </div>
                <a asp-page="./ForgotPassword" class="auth-link">
                    Forgot password?
                </a>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center">
                <i class="bi bi-box-arrow-in-right me-2"></i>
                Sign In
            </button>
        </form>

        <!-- External Logins -->
        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="text-center my-4">
                <hr>
                <span class="bg-white px-3" style="color: var(--text-tertiary); font-size: var(--font-size-sm);">
                    Or continue with
                </span>
            </div>

            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit"
                            class="btn btn-outline-secondary w-100 mb-2 d-flex align-items-center justify-content-center"
                            name="provider"
                            value="@provider.Name">
                        <i class="bi bi-google me-2"></i>
                        Continue with @provider.DisplayName
                    </button>
                }
            </form>
        }

        <!-- Footer Links -->
        <div class="auth-footer">
            <div class="auth-footer-text">
                Don't have an account?
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link ms-1">
                    <i class="bi bi-person-plus me-1"></i>Create Account
                </a>
            </div>
            
            <div class="auth-footer-text mt-2">
                <small style="color: var(--text-tertiary);">
                    Having trouble signing in? 
                    <a href="mailto:support@attendanceease.com" class="auth-link">Contact Support</a>
                </small>
            </div>
        </div>
    </div>
</div>

<!-- Demo Credentials -->
<div class="position-fixed bottom-0 end-0 p-4">
    <div class="card border-0 shadow-sm" style="max-width: 300px; background: rgba(255, 255, 255, 0.95);">
        <div class="card-body p-3">
            <h6 class="card-title mb-2" style="color: var(--text-primary); font-size: var(--font-size-sm);">
                <i class="bi bi-info-circle me-1"></i>Demo Credentials
            </h6>
            <div style="font-size: var(--font-size-xs); color: var(--text-secondary);">
                <strong>Admin:</strong> admin@attendanceease.com / Admin@123<br>
                <strong>Teacher:</strong> teacher@attendanceease.com / Teacher@123<br>
                <strong>Student:</strong> student@attendanceease.com / Student@123
            </div>
        </div>
    </div>
</div>

<!-- Loading Animation Script -->
<script>
    document.getElementById('account').addEventListener('submit', function(e) {
        const button = this.querySelector('button[type="submit"]');
        button.classList.add('btn-loading');
        button.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Signing In...';
        button.disabled = true;
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
