@page
@model LoginModel
@{
    ViewData["Title"] = "Sign In";
}

<link href="~/css/enhanced-forms.css" rel="stylesheet" />

<div class="auth-container">
    <div class="auth-card">
        <!-- Header -->
        <div class="auth-header">
            <div class="auth-logo">
                <i class="bi bi-journal-check"></i>
                <span>AttendanceEase</span>
            </div>
            <h1 class="auth-title">Welcome Back</h1>
            <p class="auth-subtitle">Sign in to your account to continue</p>
        </div>

        <!-- Success/Error Messages -->
        @if (TempData["StatusMessage"] != null)
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                @TempData["StatusMessage"]
            </div>
        }

        <!-- Form -->
        <form method="post" id="login-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            
            <!-- Email Field -->
            <div class="form-floating">
                <input asp-for="Input.Email" 
                       class="form-control" 
                       autocomplete="username" 
                       aria-required="true" 
                       placeholder="name@example.com"
                       data-validate="email" />
                <label asp-for="Input.Email">
                    <i class="bi bi-envelope me-2"></i>Email Address
                </label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <!-- Password Field -->
            <div class="form-floating">
                <input asp-for="Input.Password" 
                       class="form-control" 
                       autocomplete="current-password" 
                       aria-required="true" 
                       placeholder="Password"
                       type="password"
                       data-validate="password" />
                <label asp-for="Input.Password">
                    <i class="bi bi-lock-fill me-2"></i>Password
                </label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <!-- Remember Me -->
            <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" asp-for="Input.RememberMe" />
                <label class="form-check-label" asp-for="Input.RememberMe">
                    <i class="bi bi-bookmark-check me-1"></i>Remember me
                </label>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center">
                <i class="bi bi-box-arrow-in-right me-2"></i>
                Sign In
            </button>
        </form>

        <!-- External Logins -->
        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="text-center my-4">
                <hr>
                <span class="bg-white px-3" style="color: var(--text-tertiary); font-size: var(--font-size-sm);">
                    Or continue with
                </span>
            </div>

            <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit"
                            class="btn btn-outline-secondary w-100 mb-2 d-flex align-items-center justify-content-center"
                            name="provider"
                            value="@provider.Name">
                        <i class="bi bi-google me-2"></i>
                        Continue with @provider.DisplayName
                    </button>
                }
            </form>
        }

        <!-- Footer Links -->
        <div class="auth-footer">
            <div class="auth-footer-text">
                <a asp-page="./ForgotPassword" class="auth-link">
                    <i class="bi bi-key me-1"></i>Forgot Password?
                </a>
            </div>
            <div class="auth-footer-text mt-2">
                Don't have an account?
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link ms-1">
                    <i class="bi bi-person-plus me-1"></i>Create Account
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/form-validation.js"></script>
}
