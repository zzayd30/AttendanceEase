@page
@model IndexModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>
        <i class="bi bi-person-circle text-primary me-2"></i>
        My Profile
    </h2>
    <a asp-page="./ChangePassword" class="btn btn-outline-primary">
        <i class="bi bi-shield-lock me-1"></i>
        Change Password
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom">
                <h5 class="card-title mb-0">
                    <i class="bi bi-person-fill text-info me-2"></i>
                    Profile Information
                </h5>
            </div>
            <div class="card-body p-4">
                <form id="profile-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    
                    <!-- Email (Read-only) -->
                    <div class="form-floating mb-3">
                        <input id="username" type="text" value="@Model.Username" class="form-control" placeholder="username@example.com" disabled />
                        <label for="username">
                            <i class="bi bi-envelope me-2"></i>Email
                        </label>
                    </div>

                    <!-- Full Name -->
                    <div class="form-floating mb-3">
                        <input asp-for="Input.FullName" class="form-control" placeholder="John Doe" />
                        <label asp-for="Input.FullName">
                            <i class="bi bi-person me-2"></i>Full Name
                        </label>
                        <span asp-validation-for="Input.FullName" class="text-danger"></span>
                    </div>

                    <!-- Phone Number -->
                    <div class="form-floating mb-3">
                        <input asp-for="Input.PhoneNumber" class="form-control" placeholder="+1 (555) 123-4567" />
                        <label asp-for="Input.PhoneNumber">
                            <i class="bi bi-telephone me-2"></i>Phone Number
                        </label>
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    </div>

                    @if (User.IsInRole("Teacher"))
                    {
                        <!-- Employee ID -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.EmployeeId" class="form-control" placeholder="EMP001" />
                            <label asp-for="Input.EmployeeId">
                                <i class="bi bi-badge-tm me-2"></i>Employee ID
                            </label>
                            <span asp-validation-for="Input.EmployeeId" class="text-danger"></span>
                        </div>

                        <!-- Department -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Department" class="form-control" placeholder="Computer Science" />
                            <label asp-for="Input.Department">
                                <i class="bi bi-building me-2"></i>Department
                            </label>
                            <span asp-validation-for="Input.Department" class="text-danger"></span>
                        </div>
                    }

                    @if (User.IsInRole("Student"))
                    {
                        <!-- Roll Number -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.RollNumber" class="form-control" placeholder="2023001" />
                            <label asp-for="Input.RollNumber">
                                <i class="bi bi-hash me-2"></i>Roll Number
                            </label>
                            <span asp-validation-for="Input.RollNumber" class="text-danger"></span>
                        </div>

                        <!-- Address -->
                        <div class="form-floating mb-3">
                            <textarea asp-for="Input.Address" class="form-control" placeholder="123 Main Street, City, State" style="height: 100px;"></textarea>
                            <label asp-for="Input.Address">
                                <i class="bi bi-geo-alt me-2"></i>Address
                            </label>
                            <span asp-validation-for="Input.Address" class="text-danger"></span>
                        </div>
                    }

                    <!-- Save Button -->
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-2"></i>
                            Update Profile
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <!-- Account Information -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom">
                <h6 class="card-title mb-0">
                    <i class="bi bi-info-circle text-info me-2"></i>
                    Account Information
                </h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted">Role</small>
                    <div>
                        @if (User.IsInRole("Admin"))
                        {
                            <span class="badge bg-danger">
                                <i class="bi bi-shield-check me-1"></i>Administrator
                            </span>
                        }
                        else if (User.IsInRole("Teacher"))
                        {
                            <span class="badge bg-success">
                                <i class="bi bi-person-badge me-1"></i>Teacher
                            </span>
                        }
                        else if (User.IsInRole("Student"))
                        {
                            <span class="badge bg-primary">
                                <i class="bi bi-mortarboard me-1"></i>Student
                            </span>
                        }
                    </div>
                </div>
                
                <div class="mb-3">
                    <small class="text-muted">Member Since</small>
                    <div class="small">
                        <i class="bi bi-calendar3 me-1"></i>
                        Account created
                    </div>
                </div>

                <div class="mb-0">
                    <small class="text-muted">Email Status</small>
                    <div class="small text-success">
                        <i class="bi bi-check-circle me-1"></i>
                        Verified
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom">
                <h6 class="card-title mb-0">
                    <i class="bi bi-lightning text-warning me-2"></i>
                    Quick Actions
                </h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-page="./ChangePassword" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-shield-lock me-2"></i>Change Password
                    </a>
                    
                    <a asp-page="./Email" class="btn btn-outline-info btn-sm">
                        <i class="bi bi-envelope me-2"></i>Manage Email
                    </a>
                    
                    @if (User.IsInRole("Student"))
                    {
                        <a asp-controller="Attendance" asp-action="ViewStudent" class="btn btn-outline-success btn-sm">
                            <i class="bi bi-calendar-check me-2"></i>View Attendance
                        </a>
                    }

                    <a href="#" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-download me-2"></i>Download Data
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        document.getElementById('profile-form').addEventListener('submit', function(e) {
            const button = this.querySelector('button[type="submit"]');
            const originalHtml = button.innerHTML;
            
            button.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Updating...';
            button.disabled = true;
            
            // Re-enable button after form submission
            setTimeout(() => {
                button.innerHTML = originalHtml;
                button.disabled = false;
            }, 2000);
        });
    </script>
}