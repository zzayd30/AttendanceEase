@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-container">
    <div class="auth-card">
        <!-- Header -->
        <div class="auth-header">
            <div class="auth-logo">
                <i class="bi bi-journal-check"></i>
                <span>AttendanceEase</span>
            </div>
            <h1 class="auth-title">Forgot Password?</h1>
            <p class="auth-subtitle">No worries! Enter your email address and we'll send you a link to reset your password.</p>
        </div>

        <!-- Success/Error Messages -->
        @if (TempData["StatusMessage"] != null)
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                @TempData["StatusMessage"]
            </div>
        }

        <!-- Form -->
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            
            <div class="form-floating">
                <input asp-for="Input.Email" 
                       class="form-control" 
                       autocomplete="username" 
                       aria-required="true" 
                       placeholder="name@example.com"
                       autofocus />
                <label asp-for="Input.Email">
                    <i class="bi bi-envelope me-2"></i>Email Address
                </label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center">
                <i class="bi bi-arrow-clockwise me-2"></i>
                Send Reset Link
            </button>
        </form>

        <!-- Footer Links -->
        <div class="auth-footer">
            <div class="auth-footer-text">
                Remember your password?
                <a asp-page="./Login" class="auth-link ms-1">
                    <i class="bi bi-arrow-left me-1"></i>Back to Login
                </a>
            </div>
            
            <div class="auth-footer-text mt-2">
                Don't have an account?
                <a asp-page="./Register" class="auth-link ms-1">
                    <i class="bi bi-person-plus me-1"></i>Sign Up
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Loading Animation Script -->
<script>
    document.querySelector('form').addEventListener('submit', function(e) {
        const button = this.querySelector('button[type="submit"]');
        button.classList.add('btn-loading');
        button.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Sending...';
        button.disabled = true;
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
