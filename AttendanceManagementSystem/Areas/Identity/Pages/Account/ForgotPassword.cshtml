@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<link href="~/css/enhanced-forms.css" rel="stylesheet" />

<div class="auth-container">
    <div class="auth-card">
        <!-- Header -->
        <div class="auth-header">
            <div class="auth-logo">
                <i class="bi bi-journal-check"></i>
                <span>AttendanceEase</span>
            </div>
            <h1 class="auth-title">Forgot Password?</h1>
            <p class="auth-subtitle">No worries! Enter your email address and we'll send you a link to reset your password.</p>
        </div>

        <!-- Success/Error Messages -->
        @if (TempData["StatusMessage"] != null)
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                @TempData["StatusMessage"]
            </div>
        }

        <!-- Form -->
        <form method="post" id="forgot-password-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            
            <div class="form-floating">
                <input asp-for="Input.Email" 
                       class="form-control" 
                       autocomplete="username" 
                       aria-required="true" 
                       placeholder="name@example.com"
                       data-validate="email"
                       autofocus />
                <label asp-for="Input.Email">
                    <i class="bi bi-envelope me-2"></i>Email Address
                </label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <!-- Security Info -->
            <div class="alert alert-info mb-4">
                <i class="bi bi-shield-check me-2"></i>
                <strong>Security Notice:</strong> If this email is registered with us, you will receive a password reset link within a few minutes.
            </div>

            <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center">
                <i class="bi bi-arrow-clockwise me-2"></i>
                Send Reset Link
            </button>
        </form>

        <!-- Help Section -->
        <div class="mt-4 p-3 bg-light rounded">
            <h6 class="fw-semibold mb-2">
                <i class="bi bi-question-circle me-2"></i>Need Help?
            </h6>
            <ul class="small text-muted mb-0">
                <li>Check your spam/junk folder if you don't receive the email</li>
                <li>Make sure you're using the email address associated with your account</li>
                <li>Contact support if you continue to have issues</li>
            </ul>
        </div>

        <!-- Footer Links -->
        <div class="auth-footer">
            <div class="auth-footer-text">
                Remember your password?
                <a asp-page="./Login" class="auth-link ms-1">
                    <i class="bi bi-arrow-left me-1"></i>Back to Login
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/form-validation.js"></script>
}
