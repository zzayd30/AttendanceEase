@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password Reset Complete";
}

<link href="~/css/enhanced-forms.css" rel="stylesheet" />

<div class="auth-container">
    <div class="auth-card">
        <!-- Header -->
        <div class="auth-header">
            <div class="auth-logo">
                <i class="bi bi-journal-check"></i>
                <span>AttendanceEase</span>
            </div>
            <h1 class="auth-title">Password Reset Complete</h1>
            <p class="auth-subtitle">Your password has been successfully reset.</p>
        </div>

        <!-- Success Icon and Message -->
        <div class="text-center mb-4">
            <div class="mb-3">
                <i class="bi bi-check-circle" style="font-size: 4rem; color: var(--success);"></i>
            </div>
            <div class="alert alert-success">
                <i class="bi bi-shield-check me-2"></i>
                <strong>Password Reset Successful!</strong><br>
                Your password has been updated and your account is now secure.
            </div>
        </div>

        <!-- Next Steps -->
        <div class="mb-4">
            <h6 class="fw-semibold mb-3" style="color: var(--text-primary);">What's next:</h6>
            <ul class="list-unstyled" style="color: var(--text-secondary);">
                <li class="mb-2">
                    <i class="bi bi-1-circle-fill me-2" style="color: var(--primary-accent);"></i>
                    Use your new password to sign in
                </li>
                <li class="mb-2">
                    <i class="bi bi-2-circle-fill me-2" style="color: var(--primary-accent);"></i>
                    Make sure to remember your new password
                </li>
                <li class="mb-2">
                    <i class="bi bi-3-circle-fill me-2" style="color: var(--primary-accent);"></i>
                    Consider updating your password manager
                </li>
            </ul>
        </div>

        <!-- Security Tips -->
        <div class="alert alert-info mb-4">
            <i class="bi bi-lightbulb me-2"></i>
            <small>
                <strong>Security Tip:</strong> Keep your password safe and don't share it with anyone. 
                If you suspect your account has been compromised, contact support immediately.
            </small>
        </div>

        <!-- Action Buttons -->
        <div class="d-grid gap-2 mb-3">
            <a asp-page="./Login" class="btn btn-primary d-flex align-items-center justify-content-center">
                <i class="bi bi-box-arrow-in-right me-2"></i>
                Sign In Now
            </a>
        </div>

        <!-- Footer Links -->
        <div class="auth-footer">
            <div class="auth-footer-text text-center">
                <small style="color: var(--text-tertiary);">
                    If you're having trouble signing in with your new password, 
                    <a href="mailto:support@attendanceease.com" class="auth-link">contact support</a>.
                </small>
            </div>
        </div>
    </div>
</div>