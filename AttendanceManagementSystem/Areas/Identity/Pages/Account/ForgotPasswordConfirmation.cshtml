@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Check Your Email";
}

<div class="auth-container">
    <div class="auth-card">
        <!-- Header -->
        <div class="auth-header">
            <div class="auth-logo">
                <i class="bi bi-journal-check"></i>
                <span>AttendanceEase</span>
            </div>
            <h1 class="auth-title">Check Your Email</h1>
            <p class="auth-subtitle">We've sent a password reset link to your email address.</p>
        </div>

        <!-- Success Icon and Message -->
        <div class="text-center mb-4">
            <div class="mb-3">
                <i class="bi bi-envelope-check" style="font-size: 4rem; color: var(--success);"></i>
            </div>
            <div class="alert alert-success">
                <i class="bi bi-check-circle me-2"></i>
                <strong>Email Sent Successfully!</strong><br>
                Please check your email inbox and follow the instructions to reset your password.
            </div>
        </div>

        <!-- Instructions -->
        <div class="mb-4">
            <h6 class="fw-semibold mb-3" style="color: var(--text-primary);">What to do next:</h6>
            <ul class="list-unstyled" style="color: var(--text-secondary);">
                <li class="mb-2">
                    <i class="bi bi-1-circle-fill me-2" style="color: var(--primary-accent);"></i>
                    Check your email inbox
                </li>
                <li class="mb-2">
                    <i class="bi bi-2-circle-fill me-2" style="color: var(--primary-accent);"></i>
                    Click the reset password link
                </li>
                <li class="mb-2">
                    <i class="bi bi-3-circle-fill me-2" style="color: var(--primary-accent);"></i>
                    Create a new secure password
                </li>
            </ul>
        </div>

        <!-- Additional Help -->
        <div class="alert alert-info mb-4">
            <i class="bi bi-info-circle me-2"></i>
            <small>
                <strong>Didn't receive the email?</strong> Check your spam folder or 
                <a asp-page="./ForgotPassword" class="auth-link">request a new reset link</a>.
            </small>
        </div>

        <!-- Footer Links -->
        <div class="auth-footer">
            <div class="auth-footer-text">
                <a asp-page="./Login" class="auth-link">
                    <i class="bi bi-arrow-left me-1"></i>Back to Login
                </a>
            </div>
            
            <div class="auth-footer-text mt-2">
                Need help?
                <a href="mailto:support@attendanceease.com" class="auth-link ms-1">
                    <i class="bi bi-envelope me-1"></i>Contact Support
                </a>
            </div>
        </div>
    </div>
</div>
