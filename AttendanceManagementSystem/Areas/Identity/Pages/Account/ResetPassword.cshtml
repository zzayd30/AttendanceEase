@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

<link href="~/css/enhanced-forms.css" rel="stylesheet" />

<div class="auth-container">
    <div class="auth-card">
        <!-- Header -->
        <div class="auth-header">
            <div class="auth-logo">
                <i class="bi bi-journal-check"></i>
                <span>AttendanceEase</span>
            </div>
            <h1 class="auth-title">Reset Password</h1>
            <p class="auth-subtitle">Enter your new password below to secure your account.</p>
        </div>

        <!-- Success/Error Messages -->
        @if (TempData["StatusMessage"] != null)
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                @TempData["StatusMessage"]
            </div>
        }

        <!-- Form -->
        <form method="post" id="reset-password-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            
            <!-- Hidden Code Field -->
            <input asp-for="Input.Code" type="hidden" />
            
            <!-- Email Field -->
            <div class="form-floating">
                <input asp-for="Input.Email" 
                       class="form-control" 
                       autocomplete="username" 
                       aria-required="true" 
                       placeholder="name@example.com"
                       readonly />
                <label asp-for="Input.Email">
                    <i class="bi bi-envelope me-2"></i>Email Address
                </label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <!-- Password Field with Validation -->
            <div class="form-floating">
                <input asp-for="Input.Password" 
                       class="form-control" 
                       autocomplete="new-password" 
                       aria-required="true" 
                       placeholder="Enter new password"
                       type="password"
                       id="password-input"
                       data-validate="password" />
                <label asp-for="Input.Password">
                    <i class="bi bi-lock me-2"></i>New Password
                </label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <!-- Confirm Password Field with Validation -->
            <div class="form-floating">
                <input asp-for="Input.ConfirmPassword" 
                       class="form-control" 
                       autocomplete="new-password" 
                       aria-required="true" 
                       placeholder="Confirm new password"
                       type="password"
                       id="confirm-password-input"
                       data-validate="confirmPassword" />
                <label asp-for="Input.ConfirmPassword">
                    <i class="bi bi-lock-fill me-2"></i>Confirm Password
                </label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <!-- Password Requirements Info -->
            <div class="alert alert-info mb-4">
                <i class="bi bi-info-circle me-2"></i>
                <strong>Password Requirements:</strong>
                <ul class="mb-0 mt-2 small">
                    <li>At least 6 characters long</li>
                    <li>Contains uppercase and lowercase letters</li>
                    <li>Contains at least one number</li>
                </ul>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center">
                <i class="bi bi-check-circle me-2"></i>
                Reset Password
            </button>
        </form>

        <!-- Footer Links -->
        <div class="auth-footer">
            <div class="auth-footer-text">
                <a asp-page="./Login" class="auth-link">
                    <i class="bi bi-arrow-left me-1"></i>Back to Login
                </a>
            </div>
            
            <div class="auth-footer-text mt-2">
                Need help?
                <a href="mailto:support@attendanceease.com" class="auth-link ms-1">
                    <i class="bi bi-envelope me-1"></i>Contact Support
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/form-validation.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize form validator with password strength checking
            new FormValidator('reset-password-form', {
                validateOnBlur: true,
                showPasswordStrength: true,
                submitViaAjax: false
            });
            
            // Additional real-time confirm password validation
            const passwordInput = document.getElementById('password-input');
            const confirmPasswordInput = document.getElementById('confirm-password-input');
            
            if (passwordInput && confirmPasswordInput) {
                confirmPasswordInput.addEventListener('input', function() {
                    const password = passwordInput.value;
                    const confirmPassword = this.value;
                    
                    // Clear previous validation
                    this.classList.remove('is-invalid', 'is-valid');
                    const errorSpan = this.parentNode.querySelector('.field-error');
                    if (errorSpan) errorSpan.textContent = '';
                    
                    if (confirmPassword) {
                        if (password === confirmPassword) {
                            this.classList.add('is-valid');
                        } else {
                            this.classList.add('is-invalid');
                            let errorContainer = this.parentNode.querySelector('.field-error');
                            if (!errorContainer) {
                                errorContainer = document.createElement('div');
                                errorContainer.className = 'field-error text-danger small mt-1';
                                this.parentNode.appendChild(errorContainer);
                            }
                            errorContainer.textContent = 'Passwords do not match';
                        }
                    }
                });
            }
        });
    </script>
}
