@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="auth-container">
    <div class="auth-card">
        <!-- Header -->
        <div class="auth-header">
            <div class="auth-logo">
                <i class="bi bi-journal-check"></i>
                <span>AttendanceEase</span>
            </div>
            <h1 class="auth-title">Reset Password</h1>
            <p class="auth-subtitle">Enter your new password below to secure your account.</p>
        </div>

        <!-- Form -->
        <form method="post" id="reset-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            
            <!-- Hidden Code Field -->
            <input asp-for="Input.Code" type="hidden" />
            
            <!-- Email Field -->
            <div class="form-floating">
                <input asp-for="Input.Email" 
                       class="form-control" 
                       autocomplete="username" 
                       aria-required="true" 
                       placeholder="name@example.com"
                       readonly />
                <label asp-for="Input.Email">
                    <i class="bi bi-envelope me-2"></i>Email Address
                </label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <!-- Password Field -->
            <div class="form-floating">
                <input asp-for="Input.Password" 
                       class="form-control" 
                       autocomplete="new-password" 
                       aria-required="true" 
                       placeholder="Enter new password"
                       type="password"
                       id="password-input" />
                <label asp-for="Input.Password">
                    <i class="bi bi-lock me-2"></i>New Password
                </label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <!-- Confirm Password Field -->
            <div class="form-floating">
                <input asp-for="Input.ConfirmPassword" 
                       class="form-control" 
                       autocomplete="new-password" 
                       aria-required="true" 
                       placeholder="Confirm new password"
                       type="password"
                       id="confirm-password-input" />
                <label asp-for="Input.ConfirmPassword">
                    <i class="bi bi-lock-fill me-2"></i>Confirm Password
                </label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <!-- Password Requirements -->
            <div class="alert alert-info mb-4">
                <i class="bi bi-info-circle me-2"></i>
                <strong>Password Requirements:</strong>
                <ul class="mb-0 mt-2 small">
                    <li>At least 6 characters long</li>
                    <li>Contains uppercase and lowercase letters</li>
                    <li>Contains at least one number</li>
                    <li>Contains at least one special character</li>
                </ul>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center">
                <i class="bi bi-check-circle me-2"></i>
                Reset Password
            </button>
        </form>

        <!-- Footer Links -->
        <div class="auth-footer">
            <div class="auth-footer-text">
                <a asp-page="./Login" class="auth-link">
                    <i class="bi bi-arrow-left me-1"></i>Back to Login
                </a>
            </div>
            
            <div class="auth-footer-text mt-2">
                Need help?
                <a href="mailto:support@attendanceease.com" class="auth-link ms-1">
                    <i class="bi bi-envelope me-1"></i>Contact Support
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Password Strength Indicator -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const passwordInput = document.getElementById('password-input');
        const confirmPasswordInput = document.getElementById('confirm-password-input');
        const form = document.getElementById('reset-form');
        
        // Add password strength validation
        passwordInput.addEventListener('input', function() {
            // You can add password strength indicator here
        });
        
        // Form submission with loading state
        form.addEventListener('submit', function(e) {
            const button = this.querySelector('button[type="submit"]');
            button.classList.add('btn-loading');
            button.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Resetting...';
            button.disabled = true;
        });
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
